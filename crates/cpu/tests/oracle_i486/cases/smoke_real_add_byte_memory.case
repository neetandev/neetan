# Hand-made smoke case of the runner: ADD [BX], AL in real mode.
name = smoke_real_add_byte_memory
mode = real
bytes = 00 07
note = 80486 PRM chapter 26, ADD: 7Fh + 01h gives 80h with OF, SF and AF set and ZF, PF and CF clear.
rules =

# initial state
eax = 0x7F
ebx = 0x10
esp = 0xFFFE
eip = 0x100
eflags = 0x2
es.selector = 0x2000
es.base = 0x20000
es.limit = 0xFFFF
es.rights = 0x93
es.valid = 0x1
cs.selector = 0x1000
cs.base = 0x10000
cs.limit = 0xFFFF
cs.rights = 0x9B
cs.valid = 0x1
ss.selector = 0x3000
ss.base = 0x30000
ss.limit = 0xFFFF
ss.rights = 0x93
ss.valid = 0x1
ds.selector = 0x2000
ds.base = 0x20000
ds.limit = 0xFFFF
ds.rights = 0x93
ds.valid = 0x1
fs.limit = 0xFFFF
fs.rights = 0x93
fs.valid = 0x1
gs.limit = 0xFFFF
gs.rights = 0x93
gs.valid = 0x1
idtr.limit = 0x3FF
cr0 = 0x10
dr6 = 0xFFFF0FF0
fpu.control = 0x37F
fpu.tag = 0xFFFF

# every byte the step reads, code fetches included
memory = 010100 00 07 90
memory = 020010 01

# expected result, fields equal to the initial view omitted
expect.eip = 0x102
expect.eflags = 0x892
expect.write = 020010 80
