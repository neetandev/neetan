# Written by the Bochs lockstep harness at step 2, bus cycle 17.
name = pm_single_step_sets_bs
mode = PM32
bytes = 90
note = 80486 PRM 11.3.1.4 and 11.2.3: TF from the new TSS traps after the first instruction of the new task and sets DR6.BS.
rules = SelectorPaddingWord
# bochs events: before 1 after 1 repeat 0 hlt 0 hw [] int [01] exceptions [(01, 00)] accesses R8@2008->2008 R8@1008->1008 W4@77FC->77FC W4@77F8->77F8 W4@77F4->77F4
