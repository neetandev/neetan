# Written by the Bochs lockstep harness at step 1, bus cycle 0.
name = pm_same_privilege_int_at_cpl3_supervisor_stack_page_faults
mode = PM32
bytes = CD 30
note = 80486 PRM 6.8.3 overrides the page protection only for the inner stack of a privilege change. INT n at CPL 3 to a DPL 3 handler pushes at CPL 3, so a stack in a supervisor page gives #PF.
