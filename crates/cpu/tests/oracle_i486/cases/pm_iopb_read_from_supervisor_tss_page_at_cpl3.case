# Written by the Bochs lockstep harness at step 1, bus cycle 0.
name = pm_iopb_read_from_supervisor_tss_page_at_cpl3
mode = PM32
bytes = E4 00
note = 80486 PRM 6.8.3: the TSS reads of the I/O permission bitmap check are privilege level 0 accesses. IN at CPL 3 with IOPL 0 and the TSS in a supervisor page takes no page fault.
rules = 
# diff after the masks:
#   edi              ours 0x80000000                               bochs 0x0
# bochs events: before 1 after 1 repeat 0 hlt 0 hw [] int [] exceptions [] accesses R4@phys 10000 R4@phys 11010 W4@phys 10000 W4@phys 11010 R4@phys 10000 R4@phys 11018 W4@phys 11018 R2@6066->6066 R2@6068->6068
# bochs events: our accesses  R4@10000=11007 R4@11010=4007 X1@4000=E4 X1@4001=0 X1@4002=F4 R4@10000=11027 R4@11018=6003 R2@6066=68 R2@6068=0 W4@10000=11027 W4@11010=4027 W4@11018=6023 IN1@0=A5 irq []

# initial state
