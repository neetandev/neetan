# every byte the replay of our step from this state read, the bytes our step and Bochs read, values before the step
memory = 004000 E4 00 F4
memory = 006066 68 00 00 00
memory = 010000 07 10 01 00
memory = 011010 07 40 00 00
memory = 011018 03 60 00 00
in = 0000 1 A5

