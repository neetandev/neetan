dr3 = 0x0
dr6 = 0x0
dr7 = 0x0
cpl = 0x0
fpu.control = 0x37F
fpu.status = 0x0
fpu.fip_offset = 0x0
fpu.fip_selector = 0x0
fpu.fdp_offset = 0x0
fpu.fdp_selector = 0x0
fpu.opcode = 0x0
fpu.r0.significand = 0x0
fpu.r0.exponent = 0x0
fpu.r1.significand = 0x0
fpu.r1.exponent = 0x0
fpu.r2.significand = 0x0
fpu.r2.exponent = 0x0
fpu.r3.significand = 0x0
fpu.r3.exponent = 0x0
fpu.r4.significand = 0x0
fpu.r4.exponent = 0x0
fpu.r5.significand = 0x0
fpu.r5.exponent = 0x0
fpu.r6.significand = 0x0
fpu.r6.exponent = 0x0
fpu.r7.significand = 0x0
fpu.r7.exponent = 0x0
fpu.tag = 0xFFFF

# every byte the replay of our step from this state read, the bytes our step and Bochs read, values before the step
memory = 001090 1F 57 A0 12 08 F3 02 00
memory = 004005 0F 02 CB 0F

# expected result from Bochs, fields equal to the initial view omitted
expect.ecx = 0x2F300
expect.eip = 0x4008
expect.eflags = 0x42
mask.eflags = 0xFFDFFFFF
expect.dr7 = 0x0
mask.dr7 = 0xFFFFFBFF
expect.fpu.r0.significand = 0x0
mask.fpu.r0.significand = 0x0
