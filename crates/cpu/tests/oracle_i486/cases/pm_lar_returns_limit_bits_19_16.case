# Written by the Bochs lockstep harness at step 2, bus cycle 1.
name = pm_lar_returns_limit_bits_19_16
mode = PM32
bytes = 0F 02 CB
note = 80486 PRM chapter 26, LAR: the 32-bit form returns the second descriptor dword masked with 00FxFF00h. The processor returns the limit bits 19:16 in the x bits (observed behaviour).
rules = 
# diff after the masks:
#   ecx              ours 0xF300                                   bochs 0x2F300
# bochs events: before 1 after 1 repeat 0 hlt 0 hw [] int [] exceptions [] accesses R8@1090->1090
# bochs events: our accesses  X1@4005=F X1@4006=2 X1@4007=CB X1@4008=F R1@1090=1F R1@1091=57 R1@1092=A0 R1@1093=12 R1@1094=8 R1@1095=F3 R1@1096=2 R1@1097=0 irq []

# initial state
eax = 0x0
ecx = 0x0
edx = 0x0
ebx = 0x90
esp = 0x8000
ebp = 0x0
esi = 0x0
edi = 0x0
eip = 0x4005
eflags = 0x2
es.selector = 0x10
es.base = 0x0
es.limit = 0xFFFFFFFF
es.rights = 0x93
es.granularity = 0xCF
es.valid = 0x1
cs.selector = 0x8
cs.base = 0x0
cs.limit = 0xFFFFFFFF
cs.rights = 0x9B
