gs.rights = 0x93
gs.granularity = 0xCF
gs.valid = 0x1
ldtr.selector = 0x0
ldtr.base = 0x0
ldtr.limit = 0x0
tr.selector = 0x20
tr.base = 0x6000
tr.limit = 0x67
tr.rights = 0x8B
gdtr.base = 0x1000
gdtr.limit = 0x97
idtr.base = 0x2000
idtr.limit = 0x1FF
